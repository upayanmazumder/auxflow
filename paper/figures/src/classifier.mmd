%% Document-level decision and plan policy.
%% Sources: src/auxflow/analysis/classify.py (classify), src/auxflow/planner/lower.py (build_plan).
flowchart LR
    ARG(["ARG with<br/>labelled<br/>components"])
    Q1{"Internal<br/>STRUCTURAL<br/>edge in a<br/>component?"}
    Q2{"Any<br/>opaque<br/>fact?"}
    Q3{"Any other<br/>cycle?"}
    A["<b>AMPLIFYING</b><br/>no plan<br/>--force: 3 runs, cap 6"]
    U["<b>UNKNOWN</b><br/>3 runs, extend to fixpoint, cap 6<br/>--strict refuses"]
    B["<b>BENIGN_CYCLIC</b><br/>3 runs, extend to fixpoint<br/>cap max(6, P+1)"]
    C["<b>CERTIFIED</b><br/>P + 1 runs<br/>then confirm stable state"]

    ARG --> Q1
    Q1 -- yes --> A
    Q1 -- no --> Q2
    Q2 -- yes --> U
    Q2 -- no --> Q3
    Q3 -- yes --> B
    Q3 -- no --> C

    classDef amp fill:#F8D7DA,stroke:#A71D2A,color:#3B0A0F
    classDef unk fill:#E2E3E5,stroke:#41464B,color:#1F2326
    classDef ben fill:#FFF3CF,stroke:#8A6D00,color:#3B2F00
    classDef cert fill:#D4EDDA,stroke:#1E6B32,color:#0B2E15
    classDef dec fill:#DCE8F3,stroke:#0D1B2A,color:#0D1B2A
    classDef io fill:#FFFFFF,stroke:#5A5A5A,color:#0D1B2A
    class A amp
    class U unk
    class B ben
    class C cert
    class Q1,Q2,Q3 dec
    class ARG io
