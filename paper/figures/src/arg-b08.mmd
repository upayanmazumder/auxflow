        direction TB
        F2["<b>PAGEREF_USE</b><br/>main.tex:5:32"]
        F0["<b>CONTENT_VOLUME</b><br/>main.tex:8:3"]
        F4["<b>LABEL_PAGE</b><br/>main.tex:10:29"]
    end
    F1["<b>COUNTER_READ</b><br/>main.tex:5:10"]

    F2 == "STRUCTURAL, lag 1" ==> F0
