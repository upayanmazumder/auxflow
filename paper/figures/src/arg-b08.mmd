    class F1 plain
    style CYC fill:#FFF5F5,stroke:#A71D2A,stroke-dasharray:6 4
    linkStyle 0 stroke:#C0392B,stroke-width:3px
    linkStyle 1 stroke:#7F7F7F,stroke-width:2px
    linkStyle 2 stroke:#1F77B4,stroke-width:2px
    linkStyle 3 stroke:#C0392B,stroke-width:1.5px
